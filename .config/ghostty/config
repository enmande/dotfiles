# https://ghostty.org/docs/config

font-family = "Jet Brains Mono"
font-style = Regular
font-style-italic = Italic
font-style-bold-italic = Bold Italic
font-size = 13
background-opacity = .93
background-blur = true
window-height = 50
window-width = 200
theme = "Gruvbox Dark"

# Full-page
keybind = ctrl+f=scroll_page_down
keybind = ctrl+b=scroll_page_up

keybind = ctrl+[=text:\x1b

# unbind ctrl-tab (+shift)
# for windows in tmux (.tmux.conf)
keybind = ctrl+tab=esc:[27;5;9~
keybind = ctrl+shift+tab=esc:[27;6;9~
